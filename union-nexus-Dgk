bloquer_navigateur() {
local nav="$1"

case "$nav" in
chrome|chromium)
sudo pkill -9 -f "chrome|chromium" 2>/dev/null || true
ok "Chrome/Chromium tués"
;;
firefox)
sudo pkill -9 -f "firefox" 2>/dev/null || true
ok "Firefox tués"
;;
mozilla)
sudo pkill -9 -f "firefox|mozilla" 2>/dev/null || true
ok "Mozilla/Firefox tués"
;;
all)
sudo pkill -9 -f "chrome|chromium|firefox|mozilla|safari" 2>/dev/null || true
ok "Tous les navigateurs tués"
;;
*)
warn "Navigateur inconnu : $nav"
;;
esac

log "BLOCAGE_NAVIGATEUR" "$nav"
}

