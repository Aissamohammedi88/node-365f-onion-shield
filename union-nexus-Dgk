requete_autorisation() {
local org="$1"
local ip="$2"
local port="$3"
local process="$4"
local pid="$5"
local cmd="$6"

echo ""
separator
echo -e " ${BOLD}${R}${SYM_BLOCK} REQUÊTE D'AUTORISATION${N}"
