fi

if est_blacklist "$org"; then
ko "Organisation DÉJÀ BLOQUÉE (blacklist)"
sess_bloquer "$(sqlite3 "$SESSION_DB" 'SELECT MAX(id) FROM sessions;' 2>/dev/null)"
org_decision "$org" "deny"
return 1
fi

# Requête Y/N interactive
echo -e " ${BOLD}${Y}Autoriser cette organisation à accéder à ton local ?${N}"
echo ""
echo -e " ${G}[Y]${N} Oui, autoriser (complet)"
echo -e " ${Y}[P]${N} Autoriser uniquement en visualisation (lecture seule)"
