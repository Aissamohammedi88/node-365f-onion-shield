org_decision "$org" "deny"
return 1
;;
esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# ROUTEUR INTELLIGENT — analyse chaque connexion
# ═══════════════════════════════════════════════════════════════════════════════

routeur_scan() {
section "ROUTEUR INTELLIGENT — SCAN CONNEXIONS"

local total=0
local suspects=0
local bloques=0

# Récupérer toutes les connexions TCP/UDP
while IFS= read -r ligne; do
[ -z "$ligne" ] && continue

# Parser la ligne ss
local proto local_addr peer_addr state process
proto=$(echo "$ligne" | awk '{print $1}' | head -c 3)
local_addr=$(echo "$ligne" | awk '{print $4}')
peer_addr=$(echo "$ligne" | awk '{print $5}')
state=$(echo "$ligne" | awk '{print $2}')

local ip port
ip=$(echo "$peer_addr" | rev | cut -d: -f2- | rev)
port=$(echo "$peer_addr" | rev | cut -d: -f1 | rev)

# Ignorer localhost, DNS local
case "$ip" in
127.*|::1|0.0.0.0|*:*)
continue
;;
esac

total=$((total + 1))

# Identifier l'organisation
local org
org=$(identifier_organisation "$ip" "" "")

if [ "$org" != "Inconnu" ]; then
suspects=$((suspects + 1))

# Récupérer le processus
local pid=0 proc_name="?"
if command -v ss >/dev/null 2>&1; then
local p_info
p_info=$(ss -tunp 2>/dev/null | grep "$peer_addr" | grep -oE 'pid=[0-9]+' | head -1)
if [ -n "$p_info" ]; then
pid="${p_info#pid=}"
proc_name=$(ps -p "$pid" -o comm= 2>/dev/null || echo "?")
fi
fi

# Enregistrer la session
sess_ajouter "$org" "$ip" "$port" "$proto" "$pid" "$proc_name" "$USER" ""
org_rencontrer "$org"

# Log
log "SESSION" "$org | $ip:$port | $proc_name (PID $pid)"

# Vérifier si déjà whitelist/blacklist
if est_whitelist "$org"; then
ok "$org (whitelist) — $ip:$port"
org_decision "$org" "allow"
elif est_blacklist "$org"; then
ko "$org (blacklist) — $ip:$port"
org_decision "$org" "deny"
bloques=$((bloques + 1))
else
# Première rencontre : demander
warn "Nouvelle organisation : $org"
if ! requete_autorisation "$org" "$ip" "$port" "$proc_name" "$pid" ""; then
bloques=$((bloques + 1))
fi
fi
fi
done < <(ss -tun 2>/dev/null | tail -n +2)

separator
echo ""
echo -e " ${BOLD}Bilan du routeur :${N}"
echo -e " Total connexions : ${C}$total${N}"
echo -e " Organisations : ${Y}$suspects${N}"
echo -e " Bloquées : ${R}$bloques${N}"
echo ""
}

# ═══════════════════════════════════════════════════════════════════════════════
# SURVEILLANCE CLI TEMPS RÉEL
# ═══════════════════════════════════════════════════════════════════════════════

cli_monitor_start() {
section "MONITORING CLI TEMPS RÉEL"

cat > "$BASE/cli_monitor.sh" << 'CLIMON'
#!/bin/bash
BASE="$HOME/Documents/nexus_union_shield"
CLI_LOG="$BASE/cli_live.log"
SESSION_DB="$BASE/sessions.db"
ALERTS="$BASE/alerts.log"

log_cli() {
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" >> "$CLI_LOG"
}

# Surveiller les commandes lancées par l'utilisateur
# Via auditd si dispo
if command -v auditctl >/dev/null 2>&1; then
sudo auditctl -a always,exit -F arch=b64 -S execve -F uid=$UID -k nexus_cli 2>/dev/null || true
log_cli "Audit CLI activé pour UID $UID"
fi

# Surveiller les fichiers d'historique bash
HIST="$HOME/.bash_history"
if [ -f "$HIST" ]; then
local_size=0
log_cli "Monitoring historique bash : $HIST"
while true; do
current_size=$(stat -c%s "$HIST" 2>/dev/null || echo 0)
if [ "$current_size" -gt "$local_size" ]; then
# Nouvelles commandes
tail -c +$((local_size + 1)) "$HIST" 2>/dev/null | while read -r cmd; do
[ -z "$cmd" ] && continue

# Vérifier si la commande touche des projets locaux
if echo "$cmd" | grep -qE "(cat|less|more|vim|nano|head|tail|grep|find|cp|mv|rm).*($HOME/Documents|$HOME/Projets|$HOME/Dev)"; then
log_cli "CLI_LOCAL_ACCESS: $cmd"
fi

# Vérifier si la commande appelle un cloud
if echo "$cmd" | grep -qE "(gcloud|gsutil|aws|az|bq|curl.*google|curl.*oracle)"; then
log_cli "CLI_CLOUD_CALL: $cmd"
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [CLI_CLOUD] $cmd" >> "$ALERTS"
fi

# Enregistrer en DB
sqlite3 "$SESSION_DB" "INSERT INTO cli_events (ts, terminal, user, cmd, autorise) VALUES ('$(date -u +%Y-%m-%dT%H:%M:%SZ)', 'bash', '$USER', '$cmd', 0);" 2>/dev/null || true
done
local_size="$current_size"
fi
sleep 2
done
fi
CLIMON

chmod +x "$BASE/cli_monitor.sh"
nohup "$BASE/cli_monitor.sh" > /dev/null 2>&1 &
local pid=$!
echo "$pid" > "$PID_DIR/cli_monitor.pid"
disown 2>/dev/null || true

sleep 1
if kill -0 "$pid" 2>/dev/null; then
ok "CLI Monitor actif (PID $pid)"
else
warn "CLI Monitor n'a pas démarré"
fi
}

