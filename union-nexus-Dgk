tor_start() {
section "TOR ULTRA NODE 365-F — DÉMARRAGE"

if ! command -v tor >/dev/null 2>&1; then
info "Installation de Tor..."
sudo apt update -qq
sudo apt install -y tor torsocks obfs4proxy 2>/dev/null || true
fi

tor_config_ultra

# Arrêter l'ancien Tor
sudo pkill -x tor 2>/dev/null || true
sleep 1

# Lancer avec notre config
sudo tor -f "$TOR_CONFIG" > "$BASE/tor_runtime.log" 2>&1 &
local tor_pid=$!
echo "$tor_pid" > "$PID_DIR/tor.pid"

sleep 5

# Vérifier
local ok_tor=0
for i in 1 2 3 4 5; do
if ss -tln 2>/dev/null | grep -q ":9050"; then
ok_tor=1
break
fi
sleep 2
done

if [ "$ok_tor" = "1" ]; then
ok "Tor Ultra Node 365-F actif (PID $tor_pid)"
ok "SOCKS5 : 127.0.0.1:9050"
ok "SOCKS5 : 127.0.0.1:9150"
ok "DNS : 127.0.0.1:5353"

# Vérifier IP de sortie
local ip_tor
ip_tor=$(curl -s --socks5 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || echo "inconnu")
info "IP de sortie Tor : $ip_tor"
else
ko "Tor n'a pas démarré"
tail -10 "$BASE/tor_runtime.log" 2>/dev/null || true
fi
}

tor_stop() {
info "Arrêt Tor..."
if [ -f "$PID_DIR/tor.pid" ]; then
kill "$(cat $PID_DIR/tor.pid)" 2>/dev/null || true
rm -f "$PID_DIR/tor.pid"
fi
sudo pkill -x tor 2>/dev/null || true
ok "Tor arrêté"
}

tor_status() {
if ss -tln 2>/dev/null | grep -q ":9050"; then
local ip
ip=$(curl -s --socks5 127.0.0.1:9050 https://api.ipify.org 2>/dev/null || echo "?")
echo -e " ${G}●${N} Tor ULTRA 365-F actif — IP sortie : ${C}$ip${N}"
else
echo -e " ${Y}○${N} Tor inactif"
fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# DÉTECTION TÉLÉMÉTRIE KERNEL
# ═══════════════════════════════════════════════════════════════════════════════

kernel_telemetry_scan() {
section "DÉTECTION TÉLÉMÉTRIE KERNEL"

local trouve=0

# 1. Vérifier les modules kernel chargés suspects
subsection "Modules kernel"
local modules_suspects=$(lsmod 2>/dev/null | grep -iE "google|gcp|aws|azure|oracle|telemetry|metrics" | head -10)
if [ -n "$modules_suspects" ]; then
while IFS= read -r mod; do
warn "Module suspect : $mod"
log_kernel "module_suspect" "$mod"
trouve=1
done <<< "$modules_suspects"
else
ok "Aucun module kernel suspect"
fi

# 2. Vérifier les connexions kernel (netlink)
subsection "Netlink kernel"
if ss -ap 2>/dev/null | grep -qE "netlink"; then
info "Sockets netlink actifs (normal pour systemd)"
fi

# 3. Vérifier auditd
subsection "Audit kernel (auditd)"
if command -v auditctl >/dev/null 2>&1; then
local nb_regles=$(sudo auditctl -l 2>/dev/null | wc -l)
info "Règles auditd : $nb_regles"
if [ "$nb_regles" -eq 0 ]; then
info "Ajout de règles de surveillance..."
sudo auditctl -a always,exit -F arch=b64 -S open,openat,execve -F dir="$HOME/Documents" -k nexus_local 2>/dev/null || true
ok "Audit kernel activé sur $HOME/Documents"
fi
else
info "auditd non installé (sudo apt install auditd)"
fi

# 4. Vérifier eBPF
subsection "eBPF"
if [ -d /sys/fs/bpf ]; then
local bpf_progs=$(sudo ls /sys/fs/bpf 2>/dev/null | wc -l)
info "Programmes eBPF actifs : $bpf_progs"
if [ "$bpf_progs" -gt 0 ]; then
sudo ls /sys/fs/bpf 2>/dev/null | while read -r prog; do
info " eBPF: $prog"
log_kernel "ebpf_program" "$prog"
done
fi
else
info "eBPF non monté"
fi

# 5. Vérifier ftrace / tracepoints
subsection "Tracepoints"
if [ -d /sys/kernel/debug/tracing ]; then
local tracing_on=$(cat /sys/kernel/debug/tracing/tracing_on 2>/dev/null || echo "0")
info "Ftrace tracing : $tracing_on"
else
info "Ftrace non monté"
fi

# 6. Vérifier dmesg pour télémétrie
subsection "dmesg"
local dmesg_suspect=$(sudo dmesg 2>/dev/null | grep -iE "telemetry|google|gcp|aws|azure" | tail -5)
if [ -n "$dmesg_suspect" ]; then
warn "Logs kernel suspects :"
while IFS= read -r line; do
echo -e " ${D}$line${N}"
log_kernel "dmesg_suspect" "$line"
done <<< "$dmesg_suspect"
trouve=1
else
ok "dmesg propre"
fi

# 7. Snapshot complet vers DB
sqlite3 "$SESSION_DB" "INSERT INTO kernel_events (ts, type, detail) VALUES ('$(date -u +%Y-%m-%dT%H:%M:%SZ)', 'scan', 'kernel_telemetry_scan executed');" 2>/dev/null || true

if [ "$trouve" = "1" ]; then
alert "Télémétrie kernel détectée" "WARN"
else
ok "Aucune télémétrie kernel détectée"
fi
}

kernel_monitor_start() {
section "MONITORING KERNEL TEMPS RÉEL"

cat > "$BASE/kernel_monitor.sh" << 'KMON'
#!/bin/bash
BASE="$HOME/Documents/nexus_union_shield"
LOG="$BASE/union.log"
KERNEL_LOG="$BASE/kernel_telemetry.log"
ALERTS="$BASE/alerts.log"

log_k() {
