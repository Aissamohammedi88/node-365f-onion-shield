# ═══════════════════════════════════════════════════════════════════════════════
# AFFICHAGE
# ═══════════════════════════════════════════════════════════════════════════════

ok() { printf " ${G}${SYM_OK}${N} %s\n" "$1"; }
ko() { printf " ${R}${SYM_KO}${N} %s\n" "$1"; }
warn() { printf " ${Y}${SYM_WARN}${N} %s\n" "$1"; }
info() { printf " ${C}[i]${N} %s\n" "$1"; }
block() { printf " ${R}${SYM_BLOCK}${N} %s\n" "$1"; }
shield() { printf " ${M}${SYM_SHIELD}${N} %s\n" "$1"; }

section() {
echo ""
echo -e "${BOLD}${B}╔══════════════════════════════════════════════════════════════════════╗${N}"
printf "${BOLD}${B}║${N} ${BOLD}${W}%-68s${N} ${BOLD}${B}║${N}\n" "$1"
echo -e "${BOLD}${B}╚══════════════════════════════════════════════════════════════════════╝${N}"
echo ""
}

subsection() {
echo -e "\n ${BOLD}${M}▸ $1${N}\n"
}

separator() {
echo -e " ${D}──────────────────────────────────────────────────────────────────────${N}"
}

# ═══════════════════════════════════════════════════════════════════════════════
# LOGGER UNIFIÉ
# ═══════════════════════════════════════════════════════════════════════════════

log() {
local level="$1"
shift
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [$level] $*" >> "$LOG"
}

log_cli() {
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [CLI] $*" >> "$CLI_LOG"
}

log_kernel() {
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [KERNEL] $*" >> "$KERNEL_LOG"
}

alert() {
local msg="$1"
local niveau="${2:-WARN}"
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [$niveau] $msg" >> "$ALERTS"
if [ "$niveau" = "CRIT" ]; then
printf " ${R}${BOLD}${SYM_BLOCK} INTRUSION CRITIQUE : %s${N}\n" "$msg"
if command -v notify-send >/dev/null 2>&1; then
notify-send -u critical "NEXUS UNION SHIELD" "$msg" 2>/dev/null &
fi
else
printf " ${Y}${SYM_WARN} %s${N}\n" "$msg"
if command -v notify-send >/dev/null 2>&1; then
notify-send "NEXUS UNION SHIELD" "$msg" 2>/dev/null &
fi
fi
}

