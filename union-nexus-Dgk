ok "Base de sessions initialisée : $SESSION_DB"
}

sess_ajouter() {
local org="$1" ip="$2" port="$3" proto="$4" pid="$5" process="$6" user="$7" cmd="$8"
sqlite3 "$SESSION_DB" "INSERT INTO sessions (ts, org, ip, port, proto, pid, process, user, cmd) VALUES ('$(date -u +%Y-%m-%dT%H:%M:%SZ)', '$org', '$ip', '$port', '$proto', $pid, '$process', '$user', '$cmd');" 2>/dev/null || true
}

sess_autoriser() {
local sid="$1"
sqlite3 "$SESSION_DB" "UPDATE sessions SET autorise = 1 WHERE id = $sid;" 2>/dev/null || true
}

sess_bloquer() {
local sid="$1"
sqlite3 "$SESSION_DB" "UPDATE sessions SET bloque = 1 WHERE id = $sid;" 2>/dev/null || true
}

org_rencontrer() {
local org="$1"
sqlite3 "$SESSION_DB" "INSERT INTO organisations (nom, total_rencontres, derniere_rencontre) VALUES ('$org', 1, '$(date -u +%Y-%m-%dT%H:%M:%SZ)') ON CONFLICT(nom) DO UPDATE SET total_rencontres = total_rencontres + 1, derniere_rencontre = '$(date -u +%Y-%m-%dT%H:%M:%SZ)';" 2>/dev/null || true
}

org_decision() {
local org="$1" decision="$2"
if [ "$decision" = "allow" ]; then
sqlite3 "$SESSION_DB" "UPDATE organisations SET total_autorise = total_autorise + 1, statut = 'autorise' WHERE nom = '$org';" 2>/dev/null || true
else
sqlite3 "$SESSION_DB" "UPDATE organisations SET total_bloque = total_bloque + 1, statut = 'bloque' WHERE nom = '$org';" 2>/dev/null || true
fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# DÉTECTION ORGANISATION PAR IP / DOMAINE / PROCESS
# ═══════════════════════════════════════════════════════════════════════════════

identifier_organisation() {
local ip="$1"
local domain="$2"
local process="$3"

for entry in "${ORGANISATIONS[@]}"; do
IFS='|' read -r org ip_pattern domain_pattern ua_pattern <<< "$entry"

# Ignorer Tor Exit Node (il matche tout)
[ "$org" = "Tor Exit Node" ] && continue

# Tester IP
if [ -n "$ip" ] && echo "$ip" | grep -qE "$ip_pattern" 2>/dev/null; then
echo "$org"
return 0
fi

# Tester domaine
if [ -n "$domain" ] && echo "$domain" | grep -qiE "$domain_pattern" 2>/dev/null; then
echo "$org"
return 0
fi

# Tester process
if [ -n "$process" ] && echo "$process" | grep -qiE "$ua_pattern" 2>/dev/null; then
echo "$org"
return 0
fi
done

echo "Inconnu"
}

