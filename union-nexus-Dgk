return 0
;;
N|n)
ko "BLOQUÉ : $org"
sess_bloquer "$(sqlite3 "$SESSION_DB" 'SELECT MAX(id) FROM sessions;' 2>/dev/null)"
org_decision "$org" "deny"
log "BLOCAGE" "$org ($ip) par $USER"
return 1
;;
K|k)
block "KILL SWITCH : $org"
sess_bloquer "$(sqlite3 "$SESSION_DB" 'SELECT MAX(id) FROM sessions;' 2>/dev/null)"
org_decision "$org" "deny"
log "KILLSWITCH" "$org ($ip) PID $pid par $USER"
if [ -n "$pid" ] && [ "$pid" != "0" ]; then
sudo kill -9 "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
block "Processus $pid tué"
fi
alert "Kill switch déclenché contre $org" "CRIT"
return 1
;;
A|a)
ajouter_whitelist "$org"
ok "AUTORISÉ + whitelist : $org"
sess_autoriser "$(sqlite3 "$SESSION_DB" 'SELECT MAX(id) FROM sessions;' 2>/dev/null)"
