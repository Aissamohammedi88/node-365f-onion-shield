# ═══════════════════════════════════════════════════════════════════════════════
# KILL SWITCH GLOBAL
# ═══════════════════════════════════════════════════════════════════════════════

kill_switch() {
section "${R}KILL SWITCH GLOBAL${N}"

warn "Arrêt de tous les processus suspects..."

# Tuer tous les processus cloud
for proc in gcloud gsutil bq aws az; do
pkill -9 "$proc" 2>/dev/null && ko "$proc tué" || true
done

# Tuer navigateurs
sudo pkill -9 -f "chrome|chromium|firefox" 2>/dev/null || true
ok "Navigateurs tués"

# Couper les connexions établies vers clouds connus
local kill_count=0
ss -tun 2>/dev/null | tail -n +2 | while read -r line; do
local ip
ip=$(echo "$line" | awk '{print $5}' | cut -d: -f1)
local org
org=$(identifier_organisation "$ip" "" "")
if [ "$org" != "Inconnu" ]; then
# iptables DROP sur cette IP
sudo iptables -A OUTPUT -d "$ip" -j DROP 2>/dev/null || true
kill_count=$((kill_count + 1))
fi
done

ok "$kill_count connexions bloquées par iptables"

alert "KILL SWITCH GLOBAL activé" "CRIT"
log "KILLSWITCH_GLOBAL" "par $USER"
}

