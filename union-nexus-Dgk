# Vérifier whitelist / blacklist
if est_whitelist "$org"; then
ok "Organisation déjà AUTORISÉE (whitelist)"
sess_autoriser "$(sqlite3 "$SESSION_DB" 'SELECT MAX(id) FROM sessions;' 2>/dev/null)"
org_decision "$org" "allow"
