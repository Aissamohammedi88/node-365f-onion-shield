}

log_k "Monitoring kernel démarré (PID $$)"

# Suivre dmesg en temps réel
sudo dmesg -w 2>/dev/null | while read -r line; do
if echo "$line" | grep -qiE "telemetry|unauthorized|intrusion|google|gcp|aws|azure|oracle"; then
