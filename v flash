#  Licence : NEXUS-OPEN-2.0
#  Usage   : bash codespaces-doctor.sh [--full|--network|--ports|--perf]
# ═══════════════════════════════════════════════════════════════════════════════

set -uo pipefail

# ─── Couleurs ─────────────────────────────────────────────────────────────────
readonly G='\033[1;32m'; readonly R='\033[1;31m'; readonly Y='\033[1;33m'
readonly C='\033[1;36m'; readonly M='\033[1;35m'; readonly W='\033[1;37m'
readonly D='\033[2m';    readonly N='\033[0m'

ok()   { printf " ${G}✓${N} %s\n" "$*"; }
ko()   { printf " ${R}✗${N} %s\n" "$*"; }
warn() { printf " ${Y}!${N} %s\n" "$*"; }
info() { printf " ${C}→${N} %s\n" "$*"; }
sep()  { printf "\n${M}═══ %s ═══${N}\n" "$*"; }

ERRORS=0
WARNINGS=0

