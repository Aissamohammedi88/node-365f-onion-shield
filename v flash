# ═══════════════════════════════════════════════════════════════════════════════
# 1. IDENTITÉ DE L'ENVIRONNEMENT
# ═══════════════════════════════════════════════════════════════════════════════
check_env() {
    sep "1. IDENTITÉ DE L'ENVIRONNEMENT"

    info "Hostname   : $(hostname)"
    info "User       : $(whoami)"
    info "Shell      : $SHELL"
    info "OS         : $(uname -s) $(uname -r)"
    info "Arch       : $(uname -m)"

    # Détection Codespaces
    if [[ -n "${CODESPACES:-}" ]]; then
        ok "Codespaces détecté (CODESPACES=true)"
        info "  Codespace   : ${CODESPACE_NAME:-?}"
        info "  Repo        : ${GITHUB_REPOSITORY:-?}"
        info "  Machine     : ${CODESPACES_MACHINE_TYPE:-?}"
        info "  Région      : ${CODESPACES_REGION:-?}"
    else
        warn "Pas dans un Codespaces (variable CODESPACES absente)"
    fi

    # Workspace
    if [[ -d /workspaces ]]; then
        ok "Workspace monté : /workspaces"
        ls /workspaces/ 2>/dev/null | head -5 | sed 's/^/    /'
    else
        warn "/workspaces absent"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# 2. CONNECTIVITÉ RÉSEAU
# ═══════════════════════════════════════════════════════════════════════════════
check_network() {
    sep "2. CONNECTIVITÉ RÉSEAU"

    # 2.1 DNS
    info "Résolution DNS..."
    for host in github.com api.github.com registry.npmjs.org; do
        if host "$host" >/dev/null 2>&1 || getent hosts "$host" >/dev/null 2>&1; then
            ok "DNS $host résolu"
        else
            ko "DNS $host échoue"
            ERRORS=$((ERRORS + 1))
        fi
    done

    # 2.2 Ping
    info "Ping vers 8.8.8.8..."
    if ping -c 2 -W 3 8.8.8.8 >/dev/null 2>&1; then
        rtt=$(ping -c 2 -W 3 8.8.8.8 2>/dev/null | tail -1 | awk -F'/' '{print $5}')
        ok "Ping OK (${rtt}ms)"
    else
        warn "Ping ICMP bloqué (fréquent en Codespaces)"
    fi

    # 2.3 HTTPS
    info "Test HTTPS..."
    for url in https://github.com https://api.github.com https://registry.npmjs.org; do
        code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "$url" 2>/dev/null)
        if [[ "$code" == "200" || "$code" == "301" || "$code" == "302" ]]; then
            ok "$url → $code"
        else
            ko "$url → $code"
            ERRORS=$((ERRORS + 1))
        fi
    done

    # 2.4 Endpoints Codespaces requis
    info "Vérification endpoints Codespaces..."
    for endpoint in \
        "https://api.github.com" \
        "https://github.com" \
        "https://objects.githubusercontent.com" \
        "https://raw.githubusercontent.com" \
        "https://vscode.dev" \
        "https://*.github.dev"; do
        if curl -s -o /dev/null --max-time 8 "$endpoint" 2>/dev/null; then
            ok "$endpoint accessible"
        else
            warn "$endpoint inaccessible ou lent"
            WARNINGS=$((WARNINGS + 1))
        fi
    done
}

# ═══════════════════════════════════════════════════════════════════════════════
# 3. RESSOURCES SYSTÈME
# ═══════════════════════════════════════════════════════════════════════════════
check_resources() {
    sep "3. RESSOURCES SYSTÈME"

    # CPU
    info "CPU : $(nproc) cœurs"
    load=$(awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null)
    if [[ -n "$load" ]]; then
        load1=$(echo "$load" | awk '{print $1}')
        nproc_val=$(nproc)
        # Alerte si load > 2x CPU
        if awk "BEGIN {exit !($load1 > $nproc_val * 2)}"; then
            warn "Load élevée : $load (cœurs: $nproc_val)"
            WARNINGS=$((WARNINGS + 1))
        else
            ok "Load : $load"
        fi
    fi

    # RAM
    if [[ -f /proc/meminfo ]]; then
        total=$(awk '/MemTotal/{print $2}' /proc/meminfo)
        avail=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
        used=$((total - avail))
        pct=$((used * 100 / total))
        info "RAM : ${used}Mo / ${total}Mo (${pct}%)"
        if (( pct > 90 )); then
            ko "RAM critique (>90%)"
            ERRORS=$((ERRORS + 1))
        elif (( pct > 75 )); then
            warn "RAM élevée (>75%)"
            WARNINGS=$((WARNINGS + 1))
        else
            ok "RAM OK"
        fi
    fi

    # Disque
    info "Disque :"
    df -h /workspaces 2>/dev/null | tail -n +2 | while read -r fs size used avail pct mount; do
        printf "    %s : %s / %s (%s)\n" "$mount" "$used" "$size" "$pct"
        pct_num="${pct%\%}"
        if (( pct_num > 90 )); then
            ko "Disque $mount critique"
        fi
    done

    # Inodes
    inodes=$(df -i /workspaces 2>/dev/null | tail -1 | awk '{print $5}')
    if [[ -n "$inodes" ]]; then
        info "Inodes utilisés : $inodes"
    fi

    # Uptime container
    if [[ -f /proc/uptime ]]; then
        up=$(awk '{print int($1)}' /proc/uptime)
        days=$((up / 86400))
        hours=$(((up % 86400) / 3600))
        mins=$(((up % 3600) / 60))
        info "Uptime : ${days}j ${hours}h ${mins}m"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# 4. PORTS ET FORWARDING
# ═══════════════════════════════════════════════════════════════════════════════
check_ports() {
    sep "4. PORTS ET FORWARDING"

    # 4.1 Ports en écoute
    info "Ports en écoute :"
    printf "    %-8s %-8s %-30s %s\n" "PORT" "PROTO" "ADRESSE" "PROCESSUS"
    ss -tuln 2>/dev/null | tail -n +2 | while read -r proto recv send local peer proc; do
        port="${local##*:}"
        addr="${local%:*}"
        printf "    %-8s %-8s %-30s\n" "$port" "$proto" "$addr"
    done | head -20

    # 4.2 Détection process sur ports
    info "Processus par port :"
    if command -v lsof >/dev/null 2>&1; then
        lsof -i -P -n 2>/dev/null | grep LISTEN | head -10 | sed 's/^/    /'
    else
        sudo ss -tlnp 2>/dev/null | grep -v "State" | head -10 | sed 's/^/    /'
    fi

    # 4.3 Forwarding GitHub
    info "Forwarding Codespaces :"
    if command -v gh >/dev/null 2>&1; then
        gh codespace ports 2>/dev/null || warn "gh codespace ports indisponible"
    else
        warn "gh CLI absent — impossible de lister le forwarding"
    fi

    # 4.4 Variables d'environnement Codespaces
    info "Variables Codespaces :"
    env | grep -iE "CODESPACE|GITHUB" | sed 's/^/    /' | head -10

    # 4.5 Vérifier ports ouverts mais non forwardés
    info "Ports locaux (peuvent nécessiter forwarding) :"
    ss -tln 2>/dev/null | awk 'NR>1 {print $4}' | grep -oE ':[0-9]+$' | sort -un | while read -r p; do
        port="${p#:}"
        if (( port > 1024 && port < 65536 )); then
            printf "    Port %s en écoute (localhost)\n" "$port"
        fi
    done
}

# ═══════════════════════════════════════════════════════════════════════════════
# 5. PROCESSUS ET PERFORMANCE
# ═══════════════════════════════════════════════════════════════════════════════
check_processes() {
    sep "5. PROCESSUS ET PERFORMANCE"

    # Top CPU
    info "Top 5 CPU :"
    ps -eo pid,comm,%cpu --sort=-%cpu 2>/dev/null | head -6 | sed 's/^/    /'

    # Top RAM
    info "Top 5 RAM :"
    ps -eo pid,comm,%mem --sort=-%mem 2>/dev/null | head -6 | sed 's/^/    /'

    # Processus zombies
    zombies=$(ps -eo stat 2>/dev/null | grep -c '^Z' || echo 0)
    if (( zombies > 0 )); then
        warn "$zombies processus zombie(s)"
        WARNINGS=$((WARNINGS + 1))
    else
        ok "Aucun zombie"
    fi

    # Node.js / VS Code Server
    info "Processus VS Code Server :"
    ps aux 2>/dev/null | grep -E "vscode-server|node" | grep -v grep | head -5 | \
        awk '{printf "    PID %s — CPU %s%% — MEM %s%%\n", $2, $3, $4}'

    # Timeouts réseau
    info "Connexions établies :"
    ss -tn state established 2>/dev/null | wc -l | xargs printf "    %s connexions TCP établies\n"
}

# ═══════════════════════════════════════════════════════════════════════════════
# 6. LOGS ET ERREURS
# ═══════════════════════════════════════════════════════════════════════════════
check_logs() {
    sep "6. LOGS ET ERREURS"

    # Logs VS Code Server
    vscode_logs="$HOME/.vscode-server/data/logs"
    if [[ -d "$vscode_logs" ]]; then
        info "Logs VS Code Server récents :"
        find "$vscode_logs" -name "*.log" -mmin -60 2>/dev/null | head -5 | while read -r f; do
            printf "    %s\n" "$f"
        done

        # Chercher erreurs
        recent_err=$(grep -riE "error|fail|exception" "$vscode_logs" 2>/dev/null | tail -10)
        if [[ -n "$recent_err" ]]; then
            warn "Erreurs récentes détectées :"
            echo "$recent_err" | head -5 | sed 's/^/    /'
            WARNINGS=$((WARNINGS + 1))
        fi
    else
        info "Pas de logs VS Code Server ($vscode_logs)"
    fi

    # Logs dmesg
    info "dmesg (dernières lignes) :"
    dmesg 2>/dev/null | tail -5 | sed 's/^/    /' || \
        sudo dmesg 2>/dev/null | tail -5 | sed 's/^/    /' || \
        info "    dmesg indisponible"

    # Logs Codespaces
    if [[ -d /workspaces/.codespaces ]]; then
        info "Logs Codespaces :"
        ls -la /workspaces/.codespaces/ 2>/dev/null | head -5 | sed 's/^/    /'
    fi

    # Fichiers de log système
    info "Logs système récents :"
    journalctl --user -n 5 --no-pager 2>/dev/null | sed 's/^/    /' || \
        info "    journalctl indisponible"
}

# ═══════════════════════════════════════════════════════════════════════════════
# 7. DÉPENDANCES ET OUTILS
# ═══════════════════════════════════════════════════════════════════════════════
check_tools() {
    sep "7. DÉPENDANCES ET OUTILS"

    # Outils essentiels
    for tool in git gh node npm python3 pip docker; do
        if command -v "$tool" >/dev/null 2>&1; then
            version=$("$tool" --version 2>/dev/null | head -1)
            ok "$tool : $version"
        else
            warn "$tool absent"
            WARNINGS=$((WARNINGS + 1))
        fi
    done

    # Extensions VS Code
    if [[ -d "$HOME/.vscode-server/extensions" ]]; then
        count=$(ls "$HOME/.vscode-server/extensions" 2>/dev/null | wc -l)
        info "Extensions VS Code : $count"
    fi

    # Python
    if command -v python3 >/dev/null 2>&1; then
        info "Python : $(python3 --version)"
        info "Pip    : $(pip3 --version 2>/dev/null | head -1 || echo 'absent')"
    fi

    # Node
    if command -v node >/dev/null 2>&1; then
        info "Node : $(node --version)"
        info "NPM  : $(npm --version)"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# 8. TEST DE LATENCE VERS GITHUB
# ═══════════════════════════════════════════════════════════════════════════════
check_latency() {
    sep "8. LATENCE VERS SERVICES"

    for url in \
        "https://api.github.com" \
        "https://github.com" \
        "https://raw.githubusercontent.com"; do
        t=$(curl -s -o /dev/null -w "%{time_total}" --max-time 10 "$url" 2>/dev/null)
        if [[ -n "$t" ]]; then
            ms=$(awk "BEGIN {printf \"%d\", $t * 1000}")
            if (( ms < 500 )); then
                ok "$url : ${ms}ms"
            elif (( ms < 1500 )); then
                warn "$url : ${ms}ms"
            else
                ko "$url : ${ms}ms (lent)"
                ERRORS=$((ERRORS + 1))
            fi
        fi
    done
}

# ═══════════════════════════════════════════════════════════════════════════════
# 9. DIAGNOSTIC DEV CONTAINER
# ═══════════════════════════════════════════════════════════════════════════════
check_devcontainer() {
    sep "9. DEV CONTAINER"

    # Chercher devcontainer.json
    dc_file=""
    for f in \
        ".devcontainer/devcontainer.json" \
        ".devcontainer.json"; do
        if [[ -f "$f" ]]; then
            dc_file="$f"
            break
        fi
    done

    if [[ -n "$dc_file" ]]; then
        ok "Dev Container config trouvé : $dc_file"
        info "Contenu (extrait) :"
        head -20 "$dc_file" | sed 's/^/    /'
    else
        warn "Aucun devcontainer.json trouvé"
    fi

    # Vérifier si le container est en mode recovery
    if [[ -f /workspaces/.codespaces/.persistedshare/status.json ]]; then
        info "Status Codespaces :"
        cat /workspaces/.codespaces/.persistedshare/status.json 2>/dev/null | head -20 | sed 's/^/    /'
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# 10. RÉSUMÉ FINAL
# ═══════════════════════════════════════════════════════════════════════════════
summary() {
    sep "RÉSUMÉ FINAL"

    echo ""
    if (( ERRORS == 0 && WARNINGS == 0 )); then
        printf "${G}"
        echo "  ╔════════════════════════════════════════════════╗"
        echo "  ║   ✓ ENVIRONNEMENT SAIN — AUCUN PROBLÈME        ║"
        echo "  ╚════════════════════════════════════════════════╝"
        printf "${N}"
    elif (( ERRORS == 0 )); then
        printf "${Y}"
        echo "  ╔════════════════════════════════════════════════╗"
        echo "  ║   ! FONCTIONNEL — $WARNINGS AVERTISSEMENT(S)             ║"
        echo "  ╚════════════════════════════════════════════════╝"
        printf "${N}"
    else
        printf "${R}"
        echo "  ╔════════════════════════════════════════════════╗"
        echo "  ║   ✗ PROBLÈMES DÉTECTÉS — $ERRORS ERREUR(S)             ║"
        echo "  ╚════════════════════════════════════════════════╝"
        printf "${N}"
    fi

    echo ""
    printf "  Erreurs   : ${R}%d${N}\n" "$ERRORS"
    printf "  Avertissements : ${Y}%d${N}\n" "$WARNINGS"
    echo ""

    # Conseils selon les erreurs
    if (( ERRORS > 0 )); then
        echo -e "  ${W}Recommandations :${N}"
        echo "    • Vérifier https://www.githubstatus.com"
        echo "    • Reconstruire le Codespace (Cmd+Shift+P → Rebuild)"
        echo "    • Vérifier le firewall réseau local"
        echo "    • Contacter le support GitHub si persistant"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════════
main() {
    banner

    mode="${1:-full}"

    case "$mode" in
        --network)  check_network ;;
        --ports)    check_ports ;;
        --perf)     check_resources; check_processes ;;
        --full|*)   check_env; check_network; check_resources;
                    check_ports; check_processes; check_logs;
                    check_tools; check_latency; check_devcontainer ;;
    esac

    summary
}

main "$@"
